<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/uss/MainuiStyle.uss?fileID=7433441132597879392&amp;guid=a79fd480c87bc994a9c82d7ac4380a79&amp;type=3#MainuiStyle" />
    <ui:VisualElement name="Container" style="flex-grow: 1; white-space: normal; flex-direction: row; flex-wrap: nowrap; justify-content: flex-start; align-self: auto; align-content: auto; align-items: auto;">
        <ui:VisualElement name="InteractiveMenu" style="flex-grow: 1; position: absolute; width: 530px; height: 350px; flex-direction: column-reverse; flex-wrap: nowrap; align-self: flex-start; justify-content: flex-start; align-items: flex-start; align-content: stretch; margin-top: 0; scale: 1 1; top: auto;">
            <ui:VisualElement name="HPbar" style="flex-grow: 1; background-color: rgb(255, 0, 0); align-self: flex-start; height: 300px; width: 125px; justify-content: flex-start; align-items: center; align-content: auto; position: relative; margin-top: 0; margin-left: 28px; rotate: 0; scale: 1 1; -unity-text-align: upper-left; flex-direction: column-reverse; max-height: 325px; min-width: auto; top: -5px;" />
            <ui:VisualElement name="Healing_and_ability_container" style="flex-grow: 1; position: relative;">
                <ui:VisualElement name="HealingItemSlot" style="flex-grow: 1; background-color: rgb(179, 183, 255); position: absolute; width: 115px; height: 115px; margin-left: 335px; margin-top: 22px; min-width: auto; margin-right: 0;">
                    <ui:VisualElement name="HealingSprite" class="hpCount" style="flex-grow: 1; background-color: rgba(0, 253, 110, 0); position: relative; width: 100px; height: 100px; align-items: flex-start; justify-content: flex-start; align-self: center; align-content: center; margin-top: 0; background-image: url(&quot;project://database/Assets/Sprites/UI/HealthPotion/HP_Full.png?fileID=2800000&amp;guid=dbc2ad1d457f1ef44a49d422e23c3756&amp;type=3#HP_Full&quot;); background-size: 75% 100%; -unity-slice-type: sliced;" />
                    <ui:Label text="1" name="hpField" style="position: absolute; bottom: 0; right: 0; font-size: 50px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-outline-width: 0; text-shadow: 1.5px 2px 0 rgb(0, 0, 0);" />
                </ui:VisualElement>
                <ui:VisualElement name="AbilitySlot" style="flex-grow: 1; background-color: rgb(179, 183, 255); position: absolute; width: 115px; height: 115px; margin-left: 185px; margin-top: 22px; min-width: auto; max-width: none; flex-direction: column; top: auto;">
                    <ui:VisualElement name="AbilitySpriteSlot" class="abilitySprite" style="flex-grow: 1; background-color: rgba(0, 253, 110, 0); position: relative; width: 100px; height: 100px; align-items: flex-start; justify-content: flex-start; align-self: center; align-content: center; margin-top: 0; background-image: url(&quot;project://database/Assets/Sprites/basicItemSprite.png?fileID=2800000&amp;guid=f75f3a775595a0b48b04fc2d0b721298&amp;type=3#basicItemSprite&quot;); max-height: none; background-size: 90% 90%;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="Q" name="abilityKeyIndicator" style="font-size: 50px; position: absolute; top: 107px; left: 218px; color: rgb(255, 255, 255); -unity-text-outline-width: 0;" />
            <ui:Label text="R" name="healItemKeyIndicator" style="font-size: 50px; position: absolute; top: 107px; left: 372px; color: rgb(255, 255, 255);" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="StatusMenu" style="flex-grow: 1; align-self: flex-end; width: 150px; justify-content: flex-start; position: absolute; height: 650px; scale: 1 1;">
        <ui:VisualElement name="StatusEffect" style="flex-grow: 1; position: relative; width: 100px; align-items: center; align-self: center; margin-top: 15px; background-color: rgb(255, 231, 0); flex-direction: column; justify-content: center; align-content: auto; flex-wrap: nowrap; background-repeat: no-repeat no-repeat; overflow: visible; flex-basis: auto; flex-shrink: 1; height: auto; margin-bottom: 0; max-height: 100px; max-width: none;" />
    </ui:VisualElement>
</ui:UXML>
