:root {
}

.button {
    align-self: flex-start;
    width: auto;
    height: auto;
    font-size: 45px;
    max-width: none;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    margin-right: 0;
    margin-left: 100px;
    transition-duration: 0.25s;
}

.button:hover {
    font-size: 65px;
}

.button:active {
    background-color: rgb(255, 0, 0);
}
