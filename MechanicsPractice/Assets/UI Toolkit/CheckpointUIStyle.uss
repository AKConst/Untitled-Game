:root {
    align-content: auto;
    align-self: center;
}

.header {
    font-size: 80px;
    align-self: center;
    -unity-text-outline-color: rgb(26, 26, 26);
    color: rgb(255, 255, 255);
}

.button {
    align-self: auto;
    font-size: 50px;
    width: 20%;
    height: 20%;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    padding-top: 0;
    margin-top: 30px;
    justify-content: flex-end;
    align-content: auto;
    align-items: auto;
    overflow: visible;
    visibility: visible;
    display: flex;
    position: relative;
    flex-wrap: nowrap;
    flex-direction: row;
    flex-basis: 1%;
    padding-left: 0;
    margin-right: 30px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 30px;
    margin-left: 30px;
}
